# 即页 环境变量示例
# 复制为 .env 后填入真实值。docker-compose 会自动读取当前目录的 .env

# 运行环境。生产环境务必设为 production
NODE_ENV=production

# 服务监听端口
PORT=8858

# 数据目录（数据库、会话、上传文件）。留空则默认 ./data。
# 用于把数据放到独立卷/分区；docker-compose 已把 ./data 挂载到 /app/data，通常无需改动。
# JPAGE_DATA_DIR=/app/data

# 管理员用户名。首次启动且 users 表为空时生效；留空则默认 "admin"
ADMIN_USER=admin

# 管理员密码，至少 8 位。首次启动且 users 表为空时生效；
# 留空则自动生成 16 位随机密码并打到启动日志（请妥善保存）
ADMIN_PASSWORD=

# 会话加密密钥，生产环境必须设置一个长随机字符串。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-random-string-here

# MCP 端点全局访问令牌（可选）。不设时 MCP 端点仍可通过用户级 API Token 访问。
# 设置后所有用户均可使用此令牌连接，适合单人使用场景。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=

# Token 明文加密密钥（可选）。用于可逆加密存储 API Token 明文，使令牌可在界面上后续查看/复制。
# 不设置时将自动在数据目录生成密钥文件（token-key.key），重启不变。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_ENCRYPTION_KEY=

# MCP 端点对外暴露的 IP/主机名。用于启动日志和 .mcp.json 中的 URL。
# 本地开发保持 localhost；部署时改为服务器实际 IP 或域名。
MCP_IP=localhost

# --- SMTP 邮件配置（可选，用于邮箱验证） ---
# 配置后支持注册邮箱验证、修改邮箱验证等功能
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your-password
SMTP_FROM="即页 <noreply@example.com>"
APP_URL=http://localhost:8858

# --- 开放注册（可选） ---
# 设为 true 开放用户自助注册（需配合 SMTP 配置使用）；不设或设为其他值则仅允许管理员创建用户。
# ALLOW_REGISTRATION=true
