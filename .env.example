# 即页 环境变量示例
# 复制为 .env 后填入真实值。docker-compose 会自动读取当前目录的 .env

# 运行环境。生产环境务必设为 production
NODE_ENV=production

# 服务监听端口
PORT=8858

# 数据目录（数据库、会话、上传文件）。留空则默认 ./data。
# 用于把数据放到独立卷/分区；docker-compose 已把 ./data 挂载到 /app/data，通常无需改动。
# JPAGE_DATA_DIR=/app/data

# 管理员用户名。首次启动且 users 表为空时生效；留空则默认 "admin"
ADMIN_USER=admin

# 管理员密码，至少 8 位。首次启动且 users 表为空时生效；
# 留空则自动生成 16 位随机密码并打到启动日志（请妥善保存）
ADMIN_PASSWORD=

# 会话加密密钥，生产环境必须设置一个长随机字符串。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-random-string-here

# 会话 cookie 是否仅通过 HTTPS 传输（可选）。
# HTTPS 部署应设为 true，防止会话 cookie 被中间人嗅探；
# 不设或设为其他值则保持 false，兼容纯 HTTP 部署（注意：HTTP 下 cookie 可被窃取）。
# COOKIE_SECURE=true

# MCP 端点全局访问令牌（可选）。不设时 MCP 端点仍可通过用户级 API Token 访问。
# 设置后所有用户均可使用此令牌连接，适合单人使用场景。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=

# Token 明文加密密钥（可选）。用于可逆加密存储 API Token 明文，使令牌可在界面上后续查看/复制。
# 不设置时将自动在数据目录生成密钥文件（token-key.key），重启不变。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_ENCRYPTION_KEY=

# MCP 端点对外暴露的 IP/主机名。用于启动日志和 .mcp.json 中的 URL。
# 本地开发保持 localhost；部署时改为服务器实际 IP 或域名。
MCP_IP=localhost

# --- 备案号（可选）---
# 填写后将在落地页和市场页脚显示 ICP 备案号（如：赣ICP备2021009043号-2）。
# 留空则不显示备案信息。
# ICP_BEIAN=赣ICP备2021009043号-2

# --- SMTP 邮件配置（可选，用于邮箱验证） ---
# 配置后支持注册邮箱验证、修改邮箱验证等功能
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your-password
SMTP_FROM="即页 <noreply@example.com>"
APP_URL=http://localhost:8858

# --- 反馈邮件接收地址（可选）---
# 用户通过「问题反馈」提交的内容会发送到此邮箱。
# 留空时按优先级回退：首个 admin 用户邮箱 → SMTP_FROM；均无则仅写库不发信。
# FEEDBACK_EMAIL=you@example.com

# --- 开放注册（可选） ---
# 设为 true 开放用户自助注册（需配合 SMTP 配置使用）；不设或设为其他值则仅允许管理员创建用户。
# ALLOW_REGISTRATION=true

# --- GitHub OAuth App（可选）---
# 在 GitHub Settings → Developer settings → OAuth Apps 创建，
# Authorization callback URL 填 https://你的域名/api/auth/github/callback
# GITHUB_CLIENT_ID=Ov23li...
# GITHUB_CLIENT_SECRET=...

# --- Google OAuth / OpenID Connect（可选）---
# 在 Google Cloud Console 创建 Web 应用 OAuth 客户端，
# 已获授权的重定向 URI 填：https://你的域名/api/auth/google/callback
# 仅申请 openid、email、profile 三个基础权限。
# GOOGLE_CLIENT_ID=1234567890-xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Google Token / OIDC 公钥请求超时，限制为 1000-60000 毫秒，默认 10000。
# GOOGLE_HTTP_TIMEOUT_MS=10000
# 生产服务器无法直连 Google 时，可配置仅供 Google OAuth 使用的可信 HTTP CONNECT 代理。
# 支持 http:// 或 https://；如含凭据，仅保存在服务端密钥环境中，禁止提交到仓库。
# GOOGLE_HTTPS_PROXY=

# --- 微信开放平台网站应用扫码登录（可选）---
# 在微信开放平台「网站应用」生成 AppSecret，并把授权回调域配置为你的 APP_URL 域名。
# 回调地址路径固定为：https://你的域名/api/auth/wechat/callback
# WECHAT_OPEN_APP_ID=wx...
# WECHAT_OPEN_APP_SECRET=

# --- 文件版本历史上限（可选） ---
# 单个文件保留的历史版本数（file_versions 表），超过则自动删除最旧的版本（含磁盘文件）。
# 当前版本存在 files 主记录、不计入此上限，故保留数 = N 个历史 + 1 个当前。
# 不设或设为非正整数时取默认值 20。
# MAX_FILE_VERSIONS=20

# --- 自动备份（可选） ---
# BACKUP_CRON 使用 cron 表达式，如 "0 2 * * *" 表示每天凌晨 2 点自动导出备份。
# BACKUP_DIR 指定备份存放目录，留空则默认保存到数据目录下的 backups/。
# BACKUP_CRON=0 2 * * *
# BACKUP_DIR=/app/data/backups
