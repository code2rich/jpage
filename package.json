{
  "name": "@code2rich/jpage",
  "version": "1.6.6",
  "description": "即页 — 零配置 HTML/Markdown 即时预览与分享工具",
  "main": "server.js",
  "bin": {
    "jpage": "bin/jpage.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "connect-sqlite3": "^0.9.15",
    "docx": "^9.7.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "marked": "^12.0.0",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.15.0",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "sqlite3": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "tar": "^7.5.16",
    "node-gyp": "^11.0.0",
